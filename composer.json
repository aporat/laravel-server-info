{
    "name": "aporat/laravel-server-info",
    "description": "Laravel package for reporting server and environment status: PHP, Laravel, system, disk, drivers, database and Redis versions, and more",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/aporat/laravel-server-info",
    "keywords": [
        "laravel",
        "server",
        "server info"
    ],
    "authors": [
        {
            "name": "Adar Porat",
            "email": "aporat28@gmail.com",
            "homepage": "https://github.com/aporat",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "laravel/pint": "^1.21",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "illuminate/database": "Required by DatabaseModule (included in laravel/framework)",
        "illuminate/redis": "Required by RedisModule (included in laravel/framework)",
        "ext-redis": "Lets RedisModule probe Redis with the phpredis client",
        "predis/predis": "Lets RedisModule probe Redis with the predis client"
    },
    "autoload": {
        "psr-4": {
            "Aporat\\ServerInfo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aporat\\ServerInfo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aporat\\ServerInfo\\ServerInfoServiceProvider"
            ],
            "aliases": {
                "ServerInfo": "Aporat\\ServerInfo\\Facades\\ServerInfo"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-ci": "phpunit --coverage-text --coverage-clover coverage.xml --log-junit junit.xml",
        "check": "vendor/bin/pint --test",
        "analyze": "phpstan analyse src --level=8 --memory-limit=-1"
    },
    "support": {
        "issues": "https://github.com/aporat/laravel-server-info/issues",
        "source": "https://github.com/aporat/laravel-server-info"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
